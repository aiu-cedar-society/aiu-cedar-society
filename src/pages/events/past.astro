---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Breadcrumb from "../../components/Breadcrumb.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";

// Fetch all lectures (past events) using Content Layer API
const allLectures = await getCollection("lectures");
const lectures = allLectures.map((lecture) => ({
    id: lecture.id,
    title: lecture.data.title,
    guest_name: lecture.data.guest_name,
    belonging: lecture.data.belonging,
    event_date: lecture.data.event_date,
    eyecatch: lecture.data.eyecatch,
}));

// Group lectures by year
const lecturesByYear = lectures.reduce(
    (acc, lecture) => {
        const year = lecture.event_date ? new Date(lecture.event_date).getFullYear() : 0;
        if (!acc[year]) {
            acc[year] = [];
        }
        acc[year].push(lecture);
        return acc;
    },
    {} as Record<number, typeof lectures>,
);

// Sort years descending
const years = Object.keys(lecturesByYear)
    .map(Number)
    .sort((a, b) => b - a);

// SEO
const seo = {
    title: "過去の講演会 | AIU Cedar Society",
    description:
        "AIU Cedar Societyがこれまでに開催した講演会のアーカイブ。芝屋市長 高島崚輔氏など、著名なゲストを招いた講演会の記録をご覧いただけます。",
    keywords: "AIU Cedar Society,過去の講演会,アーカイブ,開催履歴",
};

// Breadcrumb設定
const breadcrumbItems = [
    { label: "ホーム", href: "/" },
    { label: "過去の講演会" },
];
---

<Layout seo={seo}>
    <BreadcrumbSchema items={breadcrumbItems} />
    <div class="min-h-screen">
        <div
            class="container mx-auto px-4 md:px-6 pt-16 md:pt-20 pb-12 md:pb-20 max-w-5xl"
        >
            <Breadcrumb items={breadcrumbItems} />
            {/* Back Button */}
            <a
                href="/"
                class="inline-flex items-center text-gray-500 hover:text-[#006837] mb-8 md:mb-12 transition-colors group text-sm font-medium min-h-[44px]"
            >
                <svg
                    class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
                ホームへ
            </a>

            {/* Hero Section */}
            <div class="relative mb-12 md:mb-16" data-animate>
                <div class="relative mb-6">
                    <div class="absolute top-0 left-0 w-px h-full bg-[#006837]">
                    </div>
                    <h1 class="typography-hero pl-6">
                        過去の<span
                            class="text-[#006837] typography-hero-accent"
                            >講演会</span
                        >
                    </h1>
                </div>
                <p
                    class="text-lg md:text-xl text-gray-600 leading-relaxed pl-6 max-w-2xl"
                >
                    これまでに開催した講演会のアーカイブ
                </p>
            </div>

            {/* Year Filter Section */}
            <div
                class="mb-8 md:mb-12 bg-white rounded-lg shadow-md p-4 md:p-6 border border-gray-200"
                data-animate
                data-animate-delay="1"
            >
                <div
                    class="flex flex-col md:flex-row gap-4 items-start md:items-center"
                >
                    <span class="text-sm font-medium text-gray-600"
                        >年で絞り込み：</span
                    >
                    {/* Year Filters */}
                    <div class="flex gap-2 flex-wrap" id="year-filters">
                        <button
                            class="year-filter active px-4 py-2 rounded-lg text-sm font-medium transition-all border-2 border-[#006837] bg-[#006837] text-white"
                            data-year="all"
                        >
                            全て
                        </button>
                        {
                            years.map((year) => (
                                <button
                                    class="year-filter px-4 py-2 rounded-lg text-sm font-medium transition-all border-2 border-gray-300 text-gray-700 hover:border-[#006837] hover:bg-gray-100"
                                    data-year={year}
                                >
                                    {year}年
                                </button>
                            ))
                        }
                    </div>
                </div>

                {/* Results Count */}
                <div class="mt-4 text-sm text-gray-600">
                    <span id="result-count">全 {lectures.length} 件</span
                    >の講演会
                </div>
            </div>

            {/* Past Events - Grouped by Year */}
            {
                years.map((year) => (
                    <div class="mb-16 md:mb-20" data-year-section={year}>
                        {/* Year Header */}
                        <div
                            class="flex items-center gap-4 mb-6 md:mb-8"
                            data-animate
                        >
                            <div class="flex items-center gap-3">
                                <div class="w-1 h-8 bg-[#006837] rounded-full" />
                                <h2 class="typography-section">
                                    {year}
                                    <span class="text-[#006837]">年</span>
                                </h2>
                            </div>
                            <div class="flex-1 h-px bg-gray-200" />
                            <span class="text-sm font-medium text-gray-500 bg-gray-100 px-3 py-1 rounded-full">
                                {lecturesByYear[year].length}件
                            </span>
                        </div>

                        {/* Lectures for this year */}
                        <div class="space-y-4 md:space-y-6">
                            {lecturesByYear[year].map((lecture) => (
                                <a
                                    href={`/lectures/${lecture.id}`}
                                    class="lecture-card-wrapper block group card-tilt smooth-hover"
                                    data-title={lecture.title}
                                    data-guest={lecture.guest_name}
                                    data-year={year.toString()}
                                >
                                    <div class="bg-white/90 rounded-xl shadow-md hover:shadow-xl transition-all duration-500 overflow-hidden ring-1 ring-gray-100 group-hover:ring-[#006837]/30 lecture-card hover-lift glass-card h-full flex flex-col">
                                        {/* 画像エリア - トップページと同じ16:9比率 */}
                                        <div class="relative w-full aspect-[16/9] bg-gray-100 overflow-hidden">
                                            {lecture.eyecatch ? (
                                                <img
                                                    src={`${lecture.eyecatch.url}?w=640&fm=avif&q=80`}
                                                    srcset={`
                                                        ${lecture.eyecatch.url}?w=400&fm=avif&q=80 400w,
                                                        ${lecture.eyecatch.url}?w=640&fm=avif&q=80 640w,
                                                        ${lecture.eyecatch.url}?w=800&fm=avif&q=80 800w
                                                    `}
                                                    sizes="(max-width: 767px) 100vw, 50vw"
                                                    alt={lecture.title}
                                                    width="640"
                                                    height="360"
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                                />
                                            ) : (
                                                <div class="w-full h-full bg-gradient-to-br from-[#006837] to-[#005028] flex items-center justify-center">
                                                    <svg
                                                        class="w-16 h-16 text-white opacity-30"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="1.5"
                                                            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                                                        />
                                                    </svg>
                                                </div>
                                            )}
                                            {/* 日付オーバーレイ - トップページと同じスタイル */}
                                            <div class="absolute top-3 left-3">
                                                <div class="inline-flex items-center gap-1.5 text-xs text-white font-medium bg-black/60 backdrop-blur-sm px-3 py-1.5 rounded-full">
                                                    <svg
                                                        class="w-3.5 h-3.5 flex-shrink-0"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                                        />
                                                    </svg>
                                                    {lecture.event_date ? new Date(
                                                             lecture.event_date,
                                                         ).toLocaleDateString(
                                                             "ja-JP",
                                                             {
                                                                 year: "numeric",
                                                                 month: "short",
                                                                 day: "numeric",
                                                             },
                                                         ) : "日程未定"}
                                                </div>
                                            </div>
                                        </div>

                                        {/* コンテンツエリア - トップページと同じスタイル */}
                                        <div class="flex-1 p-4 sm:p-5 flex flex-col">
                                            {/* タイトル */}
                                            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 leading-snug group-hover:text-[#006837] transition-colors line-clamp-2">
                                                {lecture.title}
                                            </h3>

                                            {/* ゲスト名 & 所属 */}
                                            <div class="space-y-0.5 mb-4">
                                                <p class="text-sm text-[#006837] font-semibold">
                                                    {lecture.guest_name}氏
                                                </p>
                                                {lecture.belonging && (
                                                    <p class="text-xs text-gray-500 line-clamp-1">
                                                        {lecture.belonging}
                                                    </p>
                                                )}
                                            </div>

                                            {/* スペーサー */}
                                            <div class="flex-1" />

                                            {/* 詳細リンク */}
                                            <div class="flex items-center text-sm text-[#006837] font-medium pt-3 border-t border-gray-100">
                                                <span class="mr-1">
                                                    詳しく見る
                                                </span>
                                                <svg
                                                    class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M9 5l7 7-7 7"
                                                    />
                                                </svg>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</Layout>

<script>
    // Year Filter Functionality
    function initFilters() {
        const yearFilters = document.querySelectorAll(".year-filter");
        const resultCount = document.getElementById("result-count");
        const lectureCards = document.querySelectorAll(
            ".lecture-card-wrapper",
        ) as NodeListOf<HTMLElement>;

        let currentYear = "all";

        // Filter lectures by year
        function filterLectures() {
            let visibleCount = 0;
            const yearSections = document.querySelectorAll(
                "[data-year-section]",
            ) as NodeListOf<HTMLElement>;

            lectureCards.forEach((card) => {
                const year = card.dataset.year || "";
                const matchesYear =
                    currentYear === "all" || year === currentYear;

                if (matchesYear) {
                    card.style.display = "";
                    visibleCount++;
                } else {
                    card.style.display = "none";
                }
            });

            // Update year sections visibility
            yearSections.forEach((section) => {
                const sectionYear = section.dataset.yearSection;
                const visibleInSection = Array.from(lectureCards).filter(
                    (card) => {
                        return (
                            card.dataset.year === sectionYear &&
                            card.style.display !== "none"
                        );
                    },
                ).length;

                if (visibleInSection > 0) {
                    section.style.display = "";
                } else {
                    section.style.display = "none";
                }
            });

            // Update result count
            if (resultCount) {
                resultCount.textContent = `全 ${visibleCount} 件`;
            }
        }

        // Year filter handlers
        yearFilters.forEach((button) => {
            button.addEventListener("click", function (this: HTMLElement) {
                yearFilters.forEach((btn) => {
                    btn.classList.remove(
                        "active",
                        "bg-[#006837]",
                        "text-white",
                        "border-[#006837]",
                    );
                    btn.classList.add("border-gray-300", "text-gray-700");
                });

                this.classList.add(
                    "active",
                    "bg-[#006837]",
                    "text-white",
                    "border-[#006837]",
                );
                this.classList.remove("border-gray-300", "text-gray-700");

                currentYear = this.dataset.year || "all";
                filterLectures();
            });
        });
    }

    document.addEventListener("DOMContentLoaded", initFilters);
    document.addEventListener("astro:page-load", initFilters);
</script>
