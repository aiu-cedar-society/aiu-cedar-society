---
// BackgroundCarousel.astro - Elegant horizontal scrolling background image carousel
// src/assets/carousel フォルダ内の画像を自動的に読み込んで最適化表示
// 新しい画像を追加するだけでスライドショーに反映されます
// ビルド時に自動的にWebP形式に変換・圧縮されます

import { Image } from "astro:assets";

// src/assets/carousel フォルダの全画像を動的にインポート
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/carousel/*.{jpg,jpeg,png,webp,gif,JPG,JPEG,PNG,WEBP,GIF}",
    { eager: true },
);

// 画像データを配列に変換
const images = Object.values(imageModules).map((mod) => mod.default);
---

<div class="background-carousel-wrapper">
    <div class="background-carousel">
        <div class="carousel-track">
            {/* 1セット目の画像 - 最適化済み */}
            {
                images.map((image, index) => (
                    <Image
                        src={image}
                        alt=""
                        height={400}
                        quality={50}
                        format="webp"
                        loading="lazy"
                        decoding="async"
                    />
                ))
            }

            {/* 2セット目（ループ用に複製） */}
            {
                images.map((image, index) => (
                    <Image
                        src={image}
                        alt=""
                        height={400}
                        quality={50}
                        format="webp"
                        loading="lazy"
                        decoding="async"
                    />
                ))
            }
        </div>
    </div>
    <!-- Fade overlay for elegant edges -->
    <div class="fade-overlay"></div>
</div>

<style>
    .background-carousel-wrapper {
        position: fixed;
        /* ヘッダーの高さ分（約60px）下にずらす */
        top: 60px;
        left: 0;
        width: 100%;
        /* 16:9画像に最適化した高さ（画面幅の約30%で16:9の半分が見える） */
        height: 30vw;
        max-height: 35vh;
        overflow: hidden;
        z-index: -1;
        pointer-events: none;
        /* Performance optimization */
        content-visibility: auto;
        contain-intrinsic-size: 100% 30vw;
        contain: strict;
    }

    .background-carousel {
        width: 100%;
        height: 100%;
        overflow: hidden;
    }

    .carousel-track {
        display: flex;
        height: 100%;
        width: max-content;
        /* GPU-accelerated animation using transform3d */
        /* スクロール速度: 180s = ゆっくり、60s = 速い（数値を大きくすると遅くなる） */
        animation: scroll 180s linear infinite;
        will-change: transform;
        transform: translateZ(0);
        backface-visibility: hidden;
    }

    .carousel-track img {
        /* 16:9 横画像に最適化 - 高さを基準に幅を自動計算 */
        height: 100%;
        width: auto;
        aspect-ratio: 16 / 9;
        flex-shrink: 0;
        object-fit: contain;
        object-position: center center;
        opacity: 0.35;
        filter: grayscale(20%);
        display: block;
    }

    /* Fade overlay - 控えめなグラデーションで画像をより多く表示 */
    .fade-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 30%;
        background: linear-gradient(
            to bottom,
            transparent 0%,
            rgba(255, 255, 255, 0.8) 70%,
            #ffffff 100%
        );
        pointer-events: none;
    }

    @keyframes scroll {
        0% {
            transform: translate3d(0, 0, 0);
        }
        100% {
            transform: translate3d(-50%, 0, 0);
        }
    }

    /* Pause animation on reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
        .carousel-track {
            animation: none;
        }
    }

    /* Mobile: 16:9比率に合わせた高さ */
    @media (max-width: 768px) {
        .background-carousel-wrapper {
            /* モバイルでは画面幅の56.25%（16:9のフル高さ）の半分程度 */
            height: 28vw;
            max-height: 25vh;
            contain-intrinsic-size: 100% 28vw;
        }
        .carousel-track img {
            /* モバイルでは透明度を調整 */
            opacity: 0.3;
        }
    }
</style>
